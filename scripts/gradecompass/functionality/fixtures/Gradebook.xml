<!-- Reference example of the legacy Gradebook inner XML (synthetic data). -->
<!-- Consumed by src/lib/types/Gradebook.ts and the grade-calc engine (src/lib/grades). -->
<!-- This is the shape the PENDING translate.ts gradebook() must emit. See documentation.md. -->
<!--
     CRITICAL fields the app/calc engine depend on:
       Course.CourseName + Course.CourseID  -> sidebar renders these (crash if missing)
       Mark.CalculatedScoreString/Raw       -> the official displayed grade
       GradeCalculationSummary.AssignmentGradeCalc[] (Type/Weight/Points/PointsPossible)
                                            -> weighted category calc; omit => falls back to point totals
       Assignment.Point/PointPossible (scaled) + ScoreCalValue/ScoreMaxValue (unscaled)
                                            -> per-assignment grade impact + hypotheticals
       Assignment.Type                      -> maps assignment to its weight category
       Assignment.PointPossible == ""       -> extra credit
       Assignment.Notes starts "(Not For Grading)" -> excluded from calc
     Arrays: Course, Mark, Assignment, ReportPeriod are forced to arrays by
     synergy.ts `alwaysArray`; include >= 1 and they still parse as arrays.
-->
<Gradebook xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Type="Gradebook" ErrorMessage="" HideStandardGraphInd="true" HidePercentSecondary="false">
	<ReportingPeriods>
		<ReportPeriod Index="0" GradePeriod="Quarter 1" StartDate="08/14/2025" EndDate="10/17/2025" />
		<ReportPeriod Index="1" GradePeriod="Quarter 2" StartDate="10/20/2025" EndDate="01/16/2026" />
	</ReportingPeriods>
	<!-- Singular ReportingPeriod = the period this payload is FOR. _Index must match one above. -->
	<ReportingPeriod GradePeriod="Quarter 2" Index="1" StartDate="10/20/2025" EndDate="01/16/2026" />
	<Courses>
		<Course Period="1" Title="Algebra II (H) (4501)" CourseName="Algebra II (H)" CourseID="4501" Room="204" Staff="Ms. Rivera" StaffEMail="staff@demo.net" StaffGU="GU-STAFF-1" ImageType="math" HighlightPercentageCutOffForProgressBar="70" UsesRichContent="false">
			<Marks>
				<Mark MarkName="Quarter 2" ShortMarkName="Q2" CalculatedScoreString="A-" CalculatedScoreRaw="91.4">
					<GradeCalculationSummary>
						<AssignmentGradeCalc Type="Tests" Weight="60%" Points="264.0" PointsPossible="300.0" WeightedPct="52.8%" CalculatedMark="B+" />
						<AssignmentGradeCalc Type="Homework" Weight="40%" Points="96.0" PointsPossible="100.0" WeightedPct="38.4%" CalculatedMark="A" />
						<AssignmentGradeCalc Type="TOTAL" Weight="100%" Points="360.0" PointsPossible="400.0" WeightedPct="91.4%" CalculatedMark="A-" />
					</GradeCalculationSummary>
					<Assignments>
						<Assignment GradebookID="1001" Measure="Unit 4 Test" Type="Tests" Date="12/05/2025" DueDate="12/05/2025" Score="88" DisplayScore="88 out of 100" ScoreCalValue="88" TimeSincePost="20d" TotalSecondsSincePost="1728000" ScoreMaxValue="100" ScoreType="Raw Score" Points="88 / 100" Point="88" PointPossible="100" Notes="" TeacherID="1" StudentID="1" MeasureDescription="" HasDropBox="false" DropStartDate="" DropEndDate="" />
						<Assignment GradebookID="1002" Measure="Homework 4.3" Type="Homework" Date="11/28/2025" DueDate="11/28/2025" Score="10" DisplayScore="10 out of 10" ScoreCalValue="10" TimeSincePost="27d" TotalSecondsSincePost="2332800" ScoreMaxValue="10" ScoreType="Raw Score" Points="10 / 10" Point="10" PointPossible="10" Notes="" TeacherID="1" StudentID="1" MeasureDescription="" HasDropBox="false" DropStartDate="" DropEndDate="" />
					</Assignments>
				</Mark>
			</Marks>
		</Course>
	</Courses>
</Gradebook>
