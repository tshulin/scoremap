{
	"name": "grademax-backend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"dev:mock": "echo mock portal is not implemented yet && exit 1",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"check": "npm run typecheck && npm run lint && npm run test"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.10",
		"hono": "^4.12.30",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.5",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vitest": "^4.1.10"
	}
}
