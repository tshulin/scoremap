# ---------------------------------------------------------------------------
# Environment variables used by the functionality/ scripts and the dev-only
# app overrides. Copy relevant lines into a real .env (which is gitignored) or
# set them in your shell. NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Used by functionality/scripts/{capture-portal-payloads,pull-real-data}.mjs ---
# The district StudentVUE host (no protocol, no path).
SYNERGY_DOMAIN=yourdistrict-psv.edupoint.com

# Option A: log in with credentials (produces a fresh session cookie).
SYNERGY_USERNAME=you@school.net
SYNERGY_PASSWORD=your-password

# Option B (alternative to A): reuse a session cookie captured from a browser.
# Format is the raw Cookie header value. Expires after ~20 min of inactivity.
# SYNERGY_COOKIE=ASP.NET_SessionId=xxxxxxxx; EESPSV=yyyyyyyy

# --- Used by the running app (dev-only overrides; see documentation.md) ---
# Turn OFF the Mock Service Worker so the real /api/synergy proxy is used.
PUBLIC_DISABLE_MSW=true

# Make the proxy skip login and use a pre-captured cookie (demo without a password).
# These are read by src/lib/server/synergy/session.ts (devCookieSession()).
SYNERGY_DEV_DOMAIN=yourdistrict-psv.edupoint.com
SYNERGY_DEV_COOKIE=ASP.NET_SessionId=xxxxxxxx; EESPSV=yyyyyyyy
